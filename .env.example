# ORVMS — Environment Configuration
# Copy this file to .env and fill in your keys

# Server Host & Port
HOST=0.0.0.0
PORT=8000
POLL_INTERVAL=3
MAX_VESSELS=20000

# AIS Provider (aisstream or demo)
# Optional: Get a free API key at https://aisstream.io
AIS_PROVIDER=demo
AIS_API_KEY=

# ==============================================================================
# LLM Maritime AI Assistant Architecture
# ==============================================================================
# Supported LLM Providers:
# 1. gemini     -> Google Gemini (Recommended: gemini-1.5-flash or gemini-2.0-flash)
# 2. openai     -> OpenAI GPT (Recommended: gpt-4o-mini or gpt-4o)
# 3. claude     -> Anthropic Claude (Recommended: claude-3-5-sonnet)
# 4. openrouter -> OpenRouter AI Gateway (Recommended: openai/gpt-4o-mini)
# 5. ollama     -> Local Ollama (e.g. LLM_BASE_URL=http://localhost:11434, LLM_MODEL=llama3)
# 6. fallback   -> Conversational Rule-Based Officer (Zero config / offline)

LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_BASE_URL=
